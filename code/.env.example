# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์จริง (ห้าม commit .env)

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# โมเดลตอบคำถามของ LightRAG, โมเดลอ่านรูป, โมเดลตรวจความปลอดภัย
LLM_MODEL=openai/gpt-4o-mini
VISION_MODEL=openai/gpt-4o-mini
GUARD_MODEL=meta-llama/llama-guard-4-12b
# แยกเจตนา/เขียนคำถามใหม่/คุยเล่น (ปิดได้ด้วย DIALOGUE_ENABLED=false จะกลับไปส่งข้อความตรง ๆ เข้า RAG)
DIALOGUE_MODEL=openai/gpt-4o-mini
DIALOGUE_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIM=3072

# ---- LightRAG ----
# localhost ถ้ารันแอปบนเครื่อง / docker-compose จะแทนเป็น http://lightrag:9621 ให้เอง
LIGHTRAG_URL=http://localhost:9621
LIGHTRAG_API_KEY=change-me-gooddude
RAG_MODE=mix

# ---- ตัวเลือก ----
GUARD_ENABLED=true
REQUEST_TIMEOUT_SECONDS=60
MAX_IMAGE_MB=5

# ---- ความปลอดภัย/การใช้งาน (ค่าเริ่มต้นเหมาะกับรันบนเครื่องตัวเอง) ----
# หน้าเว็บที่ยอมให้เรียก API ข้ามโดเมน (คั่นด้วย ,) ถ้า deploy ให้ใส่โดเมนจริง ห้ามใช้ *
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# จำกัดข้อความต่อ IP ต่อนาที (0 = ปิด) และจำนวนคำขอที่เรียกโมเดลพร้อมกัน
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=8
# true เฉพาะเมื่ออยู่หลัง reverse proxy ที่เชื่อถือได้ (ไม่งั้นผู้โจมตีปลอม X-Forwarded-For เลี่ยง rate limit ได้)
RATE_LIMIT_TRUST_PROXY=false
# /api/check ไว้ทดสอบด้วย Postman ตอน deploy จริงให้ตั้ง false
ENABLE_CHECK_ENDPOINT=true
